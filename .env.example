# Ejecuta python scripts/setup_env.py para generar secretos locales.
JWT_SECRET=
TOKEN_KEY=
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://social:CHANGE_ME@db:5432/social
REDIS_URL=redis://redis:6379/0
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=/api
COOKIE_SECURE=false
TIMEZONE=America/Bogota
DEMO_MODE=false
# Valida una versión soportada en el portal Meta antes de habilitar este conector.
META_GRAPH_VERSION=
PUBLIC_CACHE_SECONDS=60
PUBLIC_REQUESTS_PER_MINUTE=120
PRODUCTION=false
# Producción: dominio sin https://; FRONTEND_ORIGIN debe ser https://ese-dominio
PUBLIC_DOMAIN=
